root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,json,yml,yaml}]
indent_size = 2

[*.cs]
# NINA-style: braces on the same line
csharp_new_line_before_open_brace = none
csharp_new_line_before_else = false
csharp_new_line_before_catch = false
csharp_new_line_before_finally = false
csharp_new_line_before_members_in_object_initializers = false
csharp_new_line_before_members_in_anonymous_types = false

# usings sorted alphabetically, System NOT first (matches the NINA plugin convention used here)
dotnet_sort_system_directives_first = false

csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# CA1010 (Task 10 downgrade - see task-10-report.md): NINA XAML resource-dictionary partial classes
# (e.g. [Export(typeof(ResourceDictionary))] partial class : ResourceDictionary) inherit ResourceDictionary's
# non-generic ICollection through the WPF framework base type. There is no generic collection to implement
# without abandoning the ResourceDictionary/MEF export pattern the NINA plugin host requires, so this is not
# fixable in application code. Scoped to the generated XAML partial files only.
[src/SpeckSequenceHelpers/**/*.xaml.cs]
dotnet_diagnostic.CA1010.severity = none

# CA1707 (Task 10 downgrade - see task-10-report.md): xUnit test methods use the widely-adopted
# MethodUnderTest_Scenario_ExpectedBehavior underscore convention for readability; renaming to remove
# underscores would only reduce test-name clarity with no behavior or maintainability benefit. Scoped to
# the test project only - production API members must still follow CA1707.
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none

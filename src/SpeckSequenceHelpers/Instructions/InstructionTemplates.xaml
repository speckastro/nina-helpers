<ResourceDictionary
    x:Class="SpeckSequenceHelpers.Instructions.InstructionTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:SpeckSequenceHelpers.Instructions"
    xmlns:triggers="clr-namespace:SpeckSequenceHelpers.Triggers"
    xmlns:nina="clr-namespace:NINA.View.Sequencer;assembly=NINA.Sequencer"
    xmlns:mini="clr-namespace:NINA.View.Sequencer.MiniSequencer;assembly=NINA.Sequencer"
    xmlns:ninactrl="clr-namespace:NINA.CustomControlLibrary;assembly=NINA.CustomControlLibrary"
    xmlns:conv="clr-namespace:NINA.Core.Utility.Converters;assembly=NINA.Core"
    xmlns:rules="clr-namespace:NINA.Core.Utility.ValidationRules;assembly=NINA.Core"
    xmlns:util="clr-namespace:NINA.Core.Utility;assembly=NINA.Core">

    <conv:MinusOneToEmptyStringConverter x:Key="Speck_MinusOneToEmptyStringConverter" />
    <conv:CameraDefaultValueConverter x:Key="Speck_CameraDefaultValueConverter" />
    <conv:MinusOneToBaseValueConverter x:Key="Speck_MinusOneToBaseValueConverter" />
    <conv:IntListToTextBlockListConverter x:Key="Speck_IntListToTextBlockListConverter" />
    <conv:CollectionContainsItemsToVisibilityConverter x:Key="Speck_CollectionContainsItemsToVisibilityConverter" />
    <conv:InverseCollectionContainsItemsToVisibilityConverter x:Key="Speck_InverseCollectionContainsItemsToVisibilityConverter" />
    <conv:BooleanOrToVisibilityCollapsedMultiConverter x:Key="Speck_BooleanOrToVisibilityCollapsedMultiConverter" />
    <conv:InverseBooleanConverter x:Key="Speck_InverseBooleanConverter" />

    <GeometryGroup x:Key="Speck_DitheredSlewAndCenter_SVG">
        <EllipseGeometry Center="9,9" RadiusX="8" RadiusY="8" />
        <EllipseGeometry Center="9,9" RadiusX="0.8" RadiusY="0.8" />
        <EllipseGeometry Center="13.5,5.5" RadiusX="1.6" RadiusY="1.6" />
        <PathGeometry Figures="M 9,9 L 12.5,6.5" />
    </GeometryGroup>

    <DataTemplate DataType="{x:Type local:DitheredSlewAndCenter}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Horizontal">
                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding UseManualRadius}" />
                    <TextBlock VerticalAlignment="Center" Margin="5,0,0,0" Text="Manual radius (arcsec)" />
                    <TextBox MinWidth="40" Margin="5,0,0,0" TextAlignment="Right"
                             Text="{Binding ManualRadiusArcsec}" IsEnabled="{Binding UseManualRadius}" />
                </StackPanel>
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>

    <DataTemplate x:Key="SpeckSequenceHelpers.Instructions.DitheredSlewAndCenter_Mini">
        <mini:MiniSequenceItem />
    </DataTemplate>

    <GeometryGroup x:Key="Speck_CheckRotation_SVG">
        <PathGeometry Figures="M 9,1 A 8,8 0 1 1 1.6,6 M 1.6,6 L 0,1.5 M 1.6,6 L 6,4.5" />
        <EllipseGeometry Center="9,9" RadiusX="2" RadiusY="2" />
    </GeometryGroup>

    <DataTemplate DataType="{x:Type local:CheckRotation}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="Tolerance (°)" />
                    <TextBox MinWidth="40" Margin="5,0,0,0" TextAlignment="Right" Text="{Binding ToleranceDegrees}" />
                    <CheckBox VerticalAlignment="Center" Margin="15,0,0,0" IsChecked="{Binding TreatFlippedAsEqual}" />
                    <TextBlock VerticalAlignment="Center" Margin="5,0,0,0" Text="Treat 180° flip as equal" />
                    <TextBlock VerticalAlignment="Center" Margin="15,0,0,0" FontStyle="Italic" Text="{Binding LastMeasurement}" />
                </StackPanel>
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>

    <DataTemplate x:Key="SpeckSequenceHelpers.Instructions.CheckRotation_Mini">
        <mini:MiniSequenceItem />
    </DataTemplate>

    <GeometryGroup x:Key="Speck_WaitForSkyBrightness_SVG">
        <PathGeometry Figures="M 2,16 L 2,10 L 5,10 L 5,16 Z M 7,16 L 7,3 L 10,3 L 10,16 Z M 12,16 L 12,7 L 15,7 L 15,16 Z" />
        <PathGeometry Figures="M 0,18 L 17,18" />
    </GeometryGroup>

    <DataTemplate DataType="{x:Type local:WaitForSkyBrightness}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <util:BindingProxy x:Key="Speck_SkyCameraInfo" Data="{Binding CameraInfo}" />
                    </StackPanel.Resources>
                    <TextBlock VerticalAlignment="Center" Text="Direction" />
                    <ComboBox Margin="5,0,0,0"
                              ItemsSource="{Binding Source={x:Static local:WaitForSkyBrightness.DirectionChoices}}"
                              SelectedItem="{Binding Direction}" />
                    <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Text="Exposure (s)" />
                    <TextBox MinWidth="35" Margin="5,0,0,0" TextAlignment="Right" Text="{Binding ExposureTime}" />
                    <!-- Gain: dropdown when the camera reports a discrete gain list -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding CameraInfo.Gains, Converter={StaticResource Speck_CollectionContainsItemsToVisibilityConverter}, FallbackValue=Collapsed}">
                        <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Text="Gain" />
                        <ComboBox Margin="5,0,0,0"
                                  DisplayMemberPath="Text"
                                  IsSynchronizedWithCurrentItem="True"
                                  SelectedValuePath="Text">
                            <ComboBox.ItemsSource>
                                <CompositeCollection>
                                    <TextBlock Text="{Binding Source={StaticResource Speck_SkyCameraInfo}, Path=Data.DefaultGain, UpdateSourceTrigger=PropertyChanged, StringFormat=({0})}" />
                                    <CollectionContainer Collection="{Binding Source={StaticResource Speck_SkyCameraInfo}, Path=Data.Gains, Converter={StaticResource Speck_IntListToTextBlockListConverter}}" />
                                </CompositeCollection>
                            </ComboBox.ItemsSource>
                            <ComboBox.SelectedValue>
                                <MultiBinding Converter="{StaticResource Speck_MinusOneToBaseValueConverter}"
                                              Mode="TwoWay"
                                              UpdateSourceTrigger="PropertyChanged">
                                    <Binding Mode="TwoWay" Path="Gain" UpdateSourceTrigger="PropertyChanged" />
                                    <Binding Mode="OneWay" Path="CameraInfo.DefaultGain" UpdateSourceTrigger="PropertyChanged" />
                                </MultiBinding>
                            </ComboBox.SelectedValue>
                        </ComboBox>
                    </StackPanel>

                    <!-- Gain: free entry, blank means the profile default -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding CameraInfo.Gains, Converter={StaticResource Speck_InverseCollectionContainsItemsToVisibilityConverter}, FallbackValue=Visible}">
                        <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Text="Gain" />
                        <ninactrl:HintTextBox MinWidth="40"
                                              Margin="5,0,0,0"
                                              VerticalAlignment="Center"
                                              HorizontalContentAlignment="Right"
                                              VerticalContentAlignment="Center"
                                              TextAlignment="Right"
                                              HintText="{Binding CameraInfo.DefaultGain, Mode=OneWay, Converter={StaticResource Speck_CameraDefaultValueConverter}, UpdateSourceTrigger=PropertyChanged}">
                            <ninactrl:HintTextBox.Text>
                                <Binding Path="Gain"
                                         Mode="TwoWay"
                                         Converter="{StaticResource Speck_MinusOneToEmptyStringConverter}"
                                         UpdateSourceTrigger="PropertyChanged">
                                    <Binding.ValidationRules>
                                        <rules:ShortRangeRule>
                                            <rules:ShortRangeRule.ValidRange>
                                                <rules:ShortRangeChecker Minimum="-1" Maximum="32767" />
                                            </rules:ShortRangeRule.ValidRange>
                                        </rules:ShortRangeRule>
                                    </Binding.ValidationRules>
                                </Binding>
                            </ninactrl:HintTextBox.Text>
                        </ninactrl:HintTextBox>
                    </StackPanel>

                    <!-- Offset: hidden only when a connected camera cannot set it -->
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Visibility>
                            <MultiBinding Converter="{StaticResource Speck_BooleanOrToVisibilityCollapsedMultiConverter}" FallbackValue="Visible">
                                <Binding Path="CameraInfo.Connected" Converter="{StaticResource Speck_InverseBooleanConverter}" />
                                <Binding Path="CameraInfo.CanSetOffset" />
                            </MultiBinding>
                        </StackPanel.Visibility>
                        <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Text="Offset" />
                        <ninactrl:HintTextBox MinWidth="40"
                                              Margin="5,0,0,0"
                                              VerticalAlignment="Center"
                                              HorizontalContentAlignment="Right"
                                              VerticalContentAlignment="Center"
                                              TextAlignment="Right"
                                              HintText="{Binding CameraInfo.DefaultOffset, Mode=OneWay, Converter={StaticResource Speck_CameraDefaultValueConverter}, UpdateSourceTrigger=PropertyChanged}">
                            <ninactrl:HintTextBox.Text>
                                <Binding Path="Offset"
                                         Mode="TwoWay"
                                         Converter="{StaticResource Speck_MinusOneToEmptyStringConverter}"
                                         UpdateSourceTrigger="PropertyChanged">
                                    <Binding.ValidationRules>
                                        <rules:ShortRangeRule>
                                            <rules:ShortRangeRule.ValidRange>
                                                <rules:ShortRangeChecker Minimum="-1" Maximum="32767" />
                                            </rules:ShortRangeRule.ValidRange>
                                        </rules:ShortRangeRule>
                                    </Binding.ValidationRules>
                                </Binding>
                            </ninactrl:HintTextBox.Text>
                        </ninactrl:HintTextBox>
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Text="Bin" />
                    <TextBox MinWidth="25" Margin="5,0,0,0" TextAlignment="Right" Text="{Binding Binning}" />
                    <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Text="Interval (s)" />
                    <TextBox MinWidth="35" Margin="5,0,0,0" TextAlignment="Right" Text="{Binding IntervalSeconds}" />
                    <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Text="Target (%)" />
                    <TextBox MinWidth="35" Margin="5,0,0,0" TextAlignment="Right" Text="{Binding TargetPercent}" />
                    <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Text="Tolerance (%)" />
                    <TextBox MinWidth="35" Margin="5,0,0,0" TextAlignment="Right" Text="{Binding TolerancePercent}" />
                    <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" FontStyle="Italic" Text="{Binding AduSummary}" />
                </StackPanel>
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>

    <DataTemplate x:Key="SpeckSequenceHelpers.Instructions.WaitForSkyBrightness_Mini">
        <mini:MiniSequenceItem />
    </DataTemplate>

    <GeometryGroup x:Key="Speck_AutofocusAfterPierSideChange_SVG">
        <!-- Two arrows swapping sides over a pier: left arrow pointing right, right arrow pointing left, post below -->
        <PathGeometry Figures="M 2,6 L 8,6 M 6,4 L 8,6 L 6,8 M 16,10 L 10,10 M 12,8 L 10,10 L 12,12 M 9,13 L 9,17 M 6,17 L 12,17" />
    </GeometryGroup>

    <DataTemplate DataType="{x:Type triggers:AutofocusAfterPierSideChange}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <TextBlock VerticalAlignment="Center" FontStyle="Italic" Text="{Binding Warning}" />
            </nina:SequenceBlockView.SequenceItemContent>
            <nina:SequenceBlockView.SequenceItemProgressContent>
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="Pier side" />
                    <TextBlock VerticalAlignment="Center" Margin="5,0,0,0" Text="{Binding LastSeenPierSide}" />
                </StackPanel>
            </nina:SequenceBlockView.SequenceItemProgressContent>
        </nina:SequenceBlockView>
    </DataTemplate>

    <DataTemplate x:Key="SpeckSequenceHelpers.Triggers.AutofocusAfterPierSideChange_Mini">
        <mini:MiniTrigger>
            <mini:MiniTrigger.TriggerProgressContent>
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="Pier side" />
                    <TextBlock VerticalAlignment="Center" Margin="5,0,0,0" Text="{Binding LastSeenPierSide}" />
                </StackPanel>
            </mini:MiniTrigger.TriggerProgressContent>
        </mini:MiniTrigger>
    </DataTemplate>
</ResourceDictionary>
